    "validation_status": null,
    "cultivar": "Leccino",
    "training_system": "vase",
    "water_regime": "traditional_rainfed",
    "orchard_density_trees_per_ha": 150,
    "carbon_fraction": 0.47,
    "carbon_fraction_source": "synthetic parity fixture; explicit literature proxy",
